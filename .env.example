# Public browser-safe values. The publishable key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only test configuration uses the same non-privileged publishable key.
# Never add SUPABASE_SERVICE_ROLE_KEY to this project.
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Cloudflare R2 document storage (server-only; never use NEXT_PUBLIC_).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# EU jurisdiction example: https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
DOCUMENT_MAX_FILE_SIZE_BYTES=524288000
